Environment=development
APP_VERSION=
PUBLIC_APP_URL=https://apnagate.app
SERVER_HOST=
SERVER_PORT=4000
HOST=
PORT=4000


LOG_LEVEL=
LOG_DIR=logs
LOG_MAX_SIZE=
LOG_MAX_BACKUPS=
LOG_MAX_AGE=
LOG_COMPRESS=
LOG_CONSOLE=

READ_TIMEOUT=60
WRITE_TIMEOUT=90
IDLE_TIMEOUT=

# Private image uploads (keep disabled until ImageKit delivery restrictions are verified)
IMAGEKIT_ENABLED=false
IMAGEKIT_PRIVATE_KEY=
IMAGEKIT_URL_ENDPOINT=
IMAGEKIT_FOLDER_PREFIX=dev/apna-gate

ALLOW_ORIGINS=
ALLOW_METHODS=
ALLOW_HEADERS=
ALLOW_CREDENTIALS=

RATE_LIMIT_ENABLED=
RATE_LIMIT_RPS=
RATE_LIMIT_BURST=

DB_HOST=
DB_PORT=
DB_USER=
DB_PASSWORD=
DB_NAME=
DB_SSL_MODE=
DB_MAX_OPEN_CONNS=
DB_MAX_IDLE_CONNS=
DB_CONN_MAX_LIFETIME=
AUTO_MIGRATE=

JWT_ACCESS_TOKEN_EXPIRY=900 # 15 minutes in seconds
JWT_REFRESH_TOKEN_EXPIRY=604800 # 7 days in seconds
JWT_ONBOARDING_TOKEN_EXPIRY=1800 # 30 minutes in seconds
JWT_SECRET=somethingverysecret
JWT_ISSUER=
AUTH_COOKIE_DOMAIN=

OTP_SECRET=somethingverysecretforotp
OTP_EXPIRY_SECONDS=600

RESEND_API_KEY=re_xxxxxxxxxxxxxx
EMAIL_FROM=no-reply@apnagate.org
EMAIL_FROM_NAME=Apna Gate

FCM_ENABLED=false
FCM_CREDENTIALS_PATH=../configs/smartsociety-c6553-firebase-adminsdk-fbsvc-6b430a9e2c.json
APNS_ENABLED=false
APNS_KEY_PATH=
APNS_KEY_ID=
APNS_TEAM_ID=
APNS_TOPIC=
APNS_PRODUCTION=false

# Flat member invite link TTL (Go duration, e.g. 24h, 168h)
FLAT_MEMBER_INVITE_TTL=168h

# Background jobs and retention
JOB_TIMEZONE=Asia/Kolkata
# Required: generate a random secret containing at least 32 characters.
JOB_WEBHOOK_SECRET=

# PostgreSQL backup webhook (external scheduling only)
BACKUP_ENABLED=false
BACKUP_DEPLOYMENT=production
BACKUP_TEMP_DIR=/var/lib/apna-gate/backups/tmp
BACKUP_TIMEOUT_SECONDS=7200
BACKUP_GDRIVE_FOLDER=
BACKUP_GDRIVE_CLIENT_ID=
BACKUP_GDRIVE_CLIENT_SECRET=
BACKUP_GDRIVE_REFRESH_TOKEN=
VISITOR_ENTRY_RETENTION_DAYS=90
VISITOR_INVITE_RETENTION_DAYS=90
FLAT_MEMBER_INVITE_RETENTION_DAYS=90
NOTIFICATION_RETENTION_DAYS=30
CLEANUP_BATCH_SIZE=500
VISITOR_REPORT_BATCH_SIZE=50
VISITOR_REPORT_ALLOW_RESEND=false

ENABLE_METRICS=
METRICS_PORT=
ENABLE_HEALTHZ=
ENABLE_PROFILING=

# Web delivery rollout; requires FCM_ENABLED and migrations 23 + 24.
FCM_WEB_ENABLED=false

# Active flat statuses billed by maintenance (deployment-wide; inactive flats excluded).
MAINTENANCE_ELIGIBLE_FLAT_STATUSES=vacant,occupied,blocked

# Society Hub posting limits (per user/society)
HUB_POST_LIMIT=5
HUB_POST_WINDOW_SECONDS=600
HUB_COMMENT_LIMIT=30
HUB_COMMENT_WINDOW_SECONDS=60
HUB_UPLOAD_MAX_BYTES=10485760
HUB_IMAGE_MAX_WIDTH=1600
HUB_IMAGE_MAX_HEIGHT=1600
