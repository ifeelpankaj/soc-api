    "expo-symbols": "~57.0.3",
    "expo-system-ui": "~57.0.4",
    "expo-task-manager": "~57.0.20",
    "expo-web-browser": "~57.0.3",
    "firebase": "^12.19.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-toast-message": "^2.4.0",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.10.1",
    "react-redux": "^9.3.0",
    "use-sync-external-store": "^1.6.0"
  },
  "devDependencies": {
    "@emnapi/core": "^1.11.3",
    "@emnapi/runtime": "^1.11.3",
    "@rtk-query/codegen-openapi": "^2.2.0",
    "@types/node": "^26.1.2",
    "@types/react": "~19.2.2",
    "esbuild": "^0.28.2",
    "eslint": "^9.0.0",
    "eslint-config-expo": "~57.0.2",
    "lefthook": "^2.1.10",
    "openapi-typescript": "^7.13.0",
    "tsx": "^4.23.1",
    "typescript": "~5.9.3"
  },
  "scripts": {
    "help": "node scripts/help.js",
    "prepare": "node scripts/install-lefthook.js",
    "start": "expo start",
    "prebuild": "npx expo prebuild",
    "sync:app-icons": "node scripts/sync-app-icons.js",
    "phone": "npx expo run:android",
    "dev": "expo start --dev-client",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "lint": "expo lint",
    "typecheck": "tsc --noEmit",
    "release:check": "node scripts/check-release-config.js",
    "eas-build-post-install": "node scripts/eas-release-check.js",
    "test:unit": "tsx --test src/features/profile/profile-formatters.test.ts src/features/visitors/visitor-utils.test.ts src/features/visitors/entry-action-state.test.ts src/features/visitors/photos/photo-utils.test.ts src/features/resident/invites/invite-share.test.ts src/features/resident/hooks/use-resident-entries.test.ts src/features/resident/components/resident-entries-screen.test.ts src/features/notifications/notification-routing.test.ts src/features/notifications/notification-action-core.test.ts src/lib/navigation/back-navigation.test.ts src/redux/photoUploadsSlice.test.ts src/features/visitors/photos/photo-upload-lifecycle.test.ts src/features/shared/use-paginated-query.test.ts src/features/guard/manual-entry-purpose.test.ts src/features/guard/check-in-readiness.test.ts src/features/guard/guard-footer-state.test.ts src/features/resident/pending-queue.test.ts src/features/auth/request-policy.test.ts src/features/auth/password-change.test.ts src/features/web/web-flow.test.ts src/features/web/push-worker.test.ts",
    "test:maintenance": "tsx --test src/features/resident/maintenance/maintenance.test.ts",
    "hooks:install": "node scripts/install-lefthook.js",
    "hooks:validate": "lefthook validate",
    "api:fetch": "tsx src/scripts/fetch-swagger.ts",
    "api:convert": "tsx src/scripts/convert-swagger.ts",
    "api:generate": "tsx src/scripts/generate-api.ts",
    "api:codegen": "npm run api:fetch && npm run api:convert && npm run api:generate",
    "setup:firebase-local": "node ./scripts/sync-firebase-configs.js",
    "eas:help": "node scripts/eas.js help",
    "eas:setup": "node scripts/eas.js setup",
    "eas:pull": "node scripts/eas.js pull",
    "eas:push": "node scripts/eas.js push",
    "eas:file-var": "node scripts/eas.js file-var",
    "eas:build": "node scripts/eas.js build",
    "eas:build:android:dev": "npm run eas:build -- --env development --platform android",
    "eas:build:android:preview": "npm run eas:build -- --env preview --platform android",
    "eas:build:ios:preview": "npm run eas:build -- --env preview --platform ios",
    "eas:build:android:prod": "npm run eas:build -- --env production --platform android",
    "eas:build:ios:prod": "npm run eas:build -- --env production --platform ios",
    "eas:build:all:prod": "npm run eas:build -- --env production --platform all",
    "web:worker": "node scripts/build-web-worker.js",
    "preweb": "npm run web:worker",
    "web:export": "npm run web:worker && expo export --platform web"
  },
  "overrides": {
    "metro": "0.84.5",
    "metro-config": "0.84.5",
    "metro-transform-worker": "0.84.5",
    "uuid": "^11.1.0"
  },
  "private": true
}
