EXPO_PUBLIC_API_BASE_URL=https://api.example.com
EXPO_PUBLIC_SWAGGER_URL=https://api.example.com/swagger/doc.json
EXPO_PUBLIC_WEB_BASE_URL=https://your-web-domain.com
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=

# Local native builds use ../configs/google-services.json and ../configs/GoogleService-Info.plist
# unless overridden below.

# EAS cloud build file environment variables:
# GOOGLE_SERVICES_JSON=./google-services.json
# GOOGLE_SERVICE_INFO_PLIST=./GoogleService-Info.plist

# Resident web at https://resident.apnagate.org: true allows only iPhone, iPad and Mac.
# False or missing allows all browsers. Native apps ignore these web settings.
# Public build-time values only; rebuild web after changing them.
EXPO_PUBLIC_APPLE_WEB_ENABLED=true
EXPO_PUBLIC_GOOGLE_PLAY_URL=https://play.google.com/store/apps/details?id=com.apnagate

# Enable only for staged device QA / after delivery verification.
EXPO_PUBLIC_WEB_PUSH_ENABLED=true
EXPO_PUBLIC_FIREBASE_WEB_API_KEY=
EXPO_PUBLIC_FIREBASE_WEB_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_WEB_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_WEB_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_WEB_APP_ID=
EXPO_PUBLIC_FIREBASE_WEB_VAPID_KEY=
